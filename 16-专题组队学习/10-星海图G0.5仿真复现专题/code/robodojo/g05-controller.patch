diff --git a/hybrid_rollout/robodojo/student_profile.py b/hybrid_rollout/robodojo/student_profile.py
new file mode 100644
index 0000000..dbf0b33
--- /dev/null
+++ b/hybrid_rollout/robodojo/student_profile.py
@@ -0,0 +1,35 @@
+"""Explicit inference backend contract for the local G0.5 extension."""
+import os
+
+STUDENT = os.environ.get('ROLLOUT_STUDENT', 'pi05')
+if STUDENT not in ('pi05', 'g05'):
+    raise ValueError('Unsupported student policy')
+INFER_TOOL = STUDENT + '_infer'
+HORIZON = 16 if STUDENT == 'g05' else 50
+
+
+def student_text(text):
+    if STUDENT != 'g05':
+        return text
+    return (text.replace('pi05_base_aloha_full_sim_arx-x5_seed_0', 'g05_robodojo_fm')
+        .replace('OpenPI/JAX', 'G0.5/PyTorch').replace('OpenPI-JAX', 'G0.5-PyTorch')
+        .replace('pi05_infer', 'g05_infer').replace('pi05', 'G0.5')
+        .replace('50×14', '16×14').replace('50x14', '16x14').replace('**50**', '**16**')
+        .replace('normalizer `arx_x5_sim`', 'normalizer from the released `dataset_stats.json`'))
+
+
+CONTEXT_EXTENSION = '''
+\n# Evidence ledger, context revision structured_v1
+Maintain a compact NOTES.md with: native goal and return requirement; currently
+confirmed completed subgoals; active subgoal; object/grasp hypotheses marked
+uncertain versus visually confirmed; last action and measured effect; remaining
+control steps; next observable test. Ground each update in this episode's images
+or measured robot state. A closed gripper is not evidence of a successful grasp.
+Compare the predicted robot motion with the actual post-execution observation.
+When progress stalls, name the observable cause before choosing a correction.
+Prefer a short observation interval near contact, placement or release, and a
+longer accepted prefix for unobstructed transit. Preserve the native task text
+sent to G0.5. Use only bounded recorded control tools, never reward queries,
+hidden object poses, simulator resets or alternate control connections.
+Do not assume an outcome based on historical success examples or benchmark rank.
+'''
