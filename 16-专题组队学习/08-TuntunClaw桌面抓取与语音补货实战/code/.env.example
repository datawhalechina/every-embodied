# TuntunClaw 运行配置示例（请复制为 .env 或在终端导出，切勿提交真实密码或内网私密地址）
TUNTUN_PORT=8090
TUNTUN_EXEC_MODE=simulation          # simulation | dual_sync | real_hardware
TUNTUN_VOICE_PRESET=xiaoyi           # xiaoyi | xiaoxiao | yunxi
TUNTUN_PUBLIC_URL=                   # 可选：内网穿透或公网域名，用于生成扫码二维码

# 真机 myCobot 280 Pi 配置（推荐配置 SSH 免密登录，MYCOBOT_PASS 留空）
MYCOBOT_HOST=192.168.1.100
MYCOBOT_USER=er
MYCOBOT_PASS=

# 地瓜 RDK X5 Magic Box 语音守护进程配置
MAGICBOX_HOST=192.168.1.101
MAGICBOX_VOICE_PORT=8095

# 本机 USB 相机索引（视主机连接顺序调整）
TOP_CAM_INDEX=3
C931_INDEX=2
